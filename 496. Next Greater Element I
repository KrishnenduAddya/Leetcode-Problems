public class Solution {
    public int[] NextGreaterElement(int[] nums1, int[] nums2) {
        // Dictionary to store mapping: number -> next greater element
        Dictionary<int, int> nextGreaterMap = new Dictionary<int, int>();
        Stack<int> stack = new Stack<int>(); // Monotonic decreasing stack

        // Process nums2 to build the map
        foreach (int num in nums2) {
            while (stack.Count > 0 && num > stack.Peek())
                nextGreaterMap[stack.Pop()] = num;
            stack.Push(num);
        }

        // Remaining elements in stack have no next greater → map to -1
        while (stack.Count > 0) {
            nextGreaterMap[stack.Pop()] = -1;
        }

        // Build result for nums1 using the map
        int[] result = new int[nums1.Length];
        for (int i = 0; i < nums1.Length; i++)
            result[i] = nextGreaterMap[nums1[i]];

        return result;
    }
}
