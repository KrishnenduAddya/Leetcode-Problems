public class Solution {
    public int[] DailyTemperatures(int[] temperatures) {
        // Monotonic Stack, here stack ensures we only look back at colder days.
        int n = temperatures.Length;
        int[] answer = new int[n];
        Stack<int> stack = new Stack<int>();

        for(int i = 0; i < n; i++)
        {
            // While current temperature is greater than the temperature at the index on top of the stack
            while(stack.Count > 0 && temperatures[i] > temperatures[stack.Peek()])
            {
                int prevIndex = stack.Pop(); // Pop the colder day
                answer[prevIndex] = i - prevIndex; // Calculate days waited
            }
            // Push current day's index (only for lesser or equal temperature)
            stack.Push(i);
        }
        return answer;
    }
}
